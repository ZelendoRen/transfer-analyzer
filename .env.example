# --- Indexed contract (defaults: native USDC on Avalanche C-Chain) ---
CONTRACT_ADDRESS=0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E
# Block in which the contract was deployed. Starting later skips older transfers.
START_BLOCK=7388829
RPC_URL=https://api.avax.network/ext/bc/C/rpc

# --- Indexer tuning (all optional) ---
# Max blocks requested per eth_getLogs call. Lowered automatically if the RPC refuses the range.
BATCH_SIZE=2000
# A block is indexed only after this many blocks were built on top of it.
CONFIRMATIONS=12
# Indexed blocks within this distance from the chain head are re-checked for reorgs.
REORG_WINDOW=256

# --- HTTP server ---
PORT=3000

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=transfer_analyzer
# Auto-create/alter tables on start. Set to false once you manage the schema yourself.
DB_SYNCHRONIZE=true